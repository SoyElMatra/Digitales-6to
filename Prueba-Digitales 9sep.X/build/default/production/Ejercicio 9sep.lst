0504:  ANDLW  F0
0506:  MOVWF  00
0508:  MOVLW  0F
050A:  ANDWF  F8A,W
050C:  IORWF  00,W
050E:  MOVWF  F8A
....................   #endif 
....................        
....................    delay_cycles(1); 
0510:  NOP   
....................    lcd_output_enable(1); 
0512:  BSF    F8A.0
....................    delay_us(2); 
0514:  BRA    0516
....................    lcd_output_enable(0); 
0516:  BCF    F8A.0
0518:  RETURN 0
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
051A:  BCF    F93.0
....................    lcd_rs_tris(); 
051C:  BCF    F93.1
....................    lcd_rw_tris(); 
051E:  BCF    F93.2
....................   #endif 
....................  
