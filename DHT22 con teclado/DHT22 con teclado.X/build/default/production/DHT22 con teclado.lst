*
01F2:  CLRF   68
....................       
....................    address+=x-1; 
*
01D5:  MOVLW  01
01D6:  SUBWF  66,W
01D7:  ADDWF  68,F
*
01F3:  MOVLW  01
01F4:  SUBWF  66,W
01F5:  ADDWF  68,F
....................    lcd_send_byte(0,0x80|address); 
*
