....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
....................    n |= input(LCD_DATA5) << 1; 
....................    n |= input(LCD_DATA6) << 2; 
....................    n |= input(LCD_DATA7) << 3; 
....................     
....................    return(n); 
....................   #else 
....................    return(lcd.data); 
*
0185:  MOVF   06,W
0186:  MOVWF  77
0187:  SWAPF  06,W
0188:  ANDLW  0F
0189:  MOVWF  78
*
0190:  MOVF   06,W
0191:  MOVWF  77
0192:  SWAPF  06,W
0193:  ANDLW  0F
0194:  MOVWF  78
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
....................   #else       
....................    lcdlat.data = n; 
*
0169:  SWAPF  6D,W
016A:  ANDLW  F0
016B:  MOVWF  77
016C:  MOVLW  0F
016D:  ANDWF  06,W
016E:  IORWF  77,W
016F:  MOVWF  06
....................   #endif 
....................        
....................    delay_cycles(1); 
0170:  NOP
....................    lcd_output_enable(1); 
0171:  BSF    06.0
....................    delay_us(2); 
0172:  GOTO   173
....................    lcd_output_enable(0); 
0173:  BCF    06.0
0174:  RETURN
.................... } 
