....................    static char last_key; 
06DF:  CLRF   2E
....................    static BYTE col; 
06E0:  CLRF   2F
....................  
....................    BYTE kchar; 
....................    BYTE row; 
....................  
....................    kchar='\0'; 
*
063D:  CLRF   4B
....................    if(++kbd_call_count>KBD_DEBOUNCE_FACTOR) { 
063E:  INCF   2C,F
063F:  MOVF   2C,W
0640:  SUBLW  21
0641:  BTFSC  03.0
0642:  GOTO   6BE
....................        switch (col) { 
0643:  MOVF   2F,W
0644:  BTFSC  03.2
0645:  GOTO   64D
0646:  XORLW  01
0647:  BTFSC  03.2
0648:  GOTO   653
0649:  XORLW  03
