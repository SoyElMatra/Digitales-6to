01AB:  BSF    06.1
....................    delay_cycles(1); 
01AC:  NOP
....................    lcd_output_rw(0); 
01AD:  BCF    06.2
....................    delay_cycles(1); 
01AE:  NOP
....................    lcd_output_enable(0); 
01AF:  BCF    06.0
....................    lcd_send_nibble(n >> 4); 
