....................    lcd_rs_tris(); 
0177:  BCF    06.1
....................    lcd_rw_tris(); 
0178:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
0179:  BCF    03.5
017A:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
