....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
*
01C0:  DECFSZ 67,W
01C1:  GOTO   1C3
01C2:  GOTO   1C6
*
01DE:  DECFSZ 67,W
01DF:  GOTO   1E1
01E0:  GOTO   1E4
....................       address=LCD_LINE_TWO; 
*
01C3:  MOVLW  40
01C4:  MOVWF  68
01C5:  GOTO   1C7
*
01E1:  MOVLW  40
01E2:  MOVWF  68
01E3:  GOTO   1E5
....................    else 
....................       address=0; 
*
01C6:  CLRF   68
*
01E4:  CLRF   68
....................       
....................    address+=x-1; 
*
01C7:  MOVLW  01
01C8:  SUBWF  66,W
01C9:  ADDWF  68,F
*
01E5:  MOVLW  01
01E6:  SUBWF  66,W
01E7:  ADDWF  68,F
....................    lcd_send_byte(0,0x80|address); 
*
01CA:  MOVF   68,W
01CB:  IORLW  80
01CC:  MOVWF  69
01CD:  CLRF   6A
01CE:  MOVF   69,W
01CF:  MOVWF  6B
01D0:  CALL   167
*
01E8:  MOVF   68,W
01E9:  IORLW  80
01EA:  MOVWF  69
01EB:  CLRF   6A
01EC:  MOVF   69,W
01ED:  MOVWF  6B
01EE:  CALL   167
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
*
01AF:  MOVF   65,W
01B0:  XORLW  07
01B1:  BTFSC  03.2
01B2:  GOTO   1BD
01B3:  XORLW  0B
01B4:  BTFSC  03.2
01B5:  GOTO   1D2
01B6:  XORLW  06
01B7:  BTFSC  03.2
01B8:  GOTO   1DA
01B9:  XORLW  02
01BA:  BTFSC  03.2
01BB:  GOTO   1F0
01BC:  GOTO   1F5
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
01BD:  MOVLW  01
01BE:  MOVWF  66
01BF:  MOVWF  67
*
01D1:  GOTO   1FA
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
01D2:  CLRF   6A
01D3:  MOVLW  01
01D4:  MOVWF  6B
01D5:  CALL   167
....................                      delay_ms(2); 
01D6:  MOVLW  02
01D7:  MOVWF  67
01D8:  CALL   05F
....................                     #if defined(LCD_EXTENDED_NEWLINE) 
....................                      g_LcdX = 0; 
....................                      g_LcdY = 0; 
....................                     #endif 
....................                      break; 
01D9:  GOTO   1FA
....................  
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       case '\r'   :  lcd_gotoxy(1, g_LcdY+1);   break; 
....................       case '\n'   : 
....................          while (g_LcdX++ < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, ' '); 
....................          } 
....................          lcd_gotoxy(1, g_LcdY+2); 
....................          break; 
....................      #else 
....................       case '\n'   : lcd_gotoxy(1,2);        break; 
01DA:  MOVLW  01
01DB:  MOVWF  66
01DC:  MOVLW  02
01DD:  MOVWF  67
*
01EF:  GOTO   1FA
....................      #endif 
....................       
....................       case '\b'   : lcd_send_byte(0,0x10);  break; 
01F0:  CLRF   6A
01F1:  MOVLW  10
01F2:  MOVWF  6B
01F3:  CALL   167
01F4:  GOTO   1FA
....................       
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       default     :  
....................          if (g_LcdX < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, c); 
....................             g_LcdX++; 
....................          } 
....................          break; 
....................      #else 
....................       default     : lcd_send_byte(1,c);     break; 
01F5:  MOVLW  01
01F6:  MOVWF  6A
01F7:  MOVF   65,W
01F8:  MOVWF  6B
01F9:  CALL   167
....................      #endif 
....................    } 
01FA:  RETURN
.................... } 
....................   
.................... char lcd_getc(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    char value; 
....................  
....................    lcd_gotoxy(x,y); 
....................    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low 
....................    lcd_output_rs(1); 
....................    value = lcd_read_byte(); 
....................    lcd_output_rs(0); 
....................     
....................    return(value); 
.................... } 
....................  
.................... // write a custom character to the ram 
.................... // which is 0-7 and specifies which character array we are modifying. 
.................... // ptr points to an array of 8 bytes, where each byte is the next row of 
.................... //    pixels.  only bits 0-4 are used.  the last row is the cursor row, and 
.................... //    usually you will want to leave this byte 0x00. 
.................... void lcd_set_cgram_char(unsigned int8 which, unsigned int8 *ptr) 
.................... { 
....................    unsigned int i; 
....................  
....................    which <<= 3; 
....................    which &= 0x38; 
....................  
....................    lcd_send_byte(0, 0x40 | which);  //set cgram address 
....................  
....................    for(i=0; i<8; i++) 
....................    { 
....................       lcd_send_byte(1, *ptr++); 
....................    } 
....................    
....................    #if defined(LCD_EXTENDED_NEWLINE) 
....................     lcd_gotoxy(g_LcdX+1, g_LcdY+1);  //set ddram address 
....................    #endif 
.................... } 
....................  
.................... void lcd_cursor_on(int1 on) 
.................... { 
....................    if (on) 
....................    { 
....................       lcd_send_byte(0,0x0F);           //turn LCD cursor ON 
....................    } 
....................    else 
....................    { 
....................       lcd_send_byte(0,0x0C);           //turn LCD cursor OFF 
....................    } 
.................... } 
....................  
.................... #endif 
