....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
....................    n |= input(LCD_DATA5) << 1; 
....................    n |= input(LCD_DATA6) << 2; 
....................    n |= input(LCD_DATA7) << 3; 
....................     
....................    return(n); 
....................   #else 
....................    return(lcd.data); 
*
0177:  MOVF   06,W
0178:  MOVWF  77
0179:  SWAPF  06,W
017A:  ANDLW  0F
017B:  MOVWF  78
*
0182:  MOVF   06,W
0183:  MOVWF  77
0184:  SWAPF  06,W
0185:  ANDLW  0F
0186:  MOVWF  78
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
....................   #else       
....................    lcdlat.data = n; 
*
015B:  SWAPF  6D,W
015C:  ANDLW  F0
015D:  MOVWF  77
015E:  MOVLW  0F
015F:  ANDWF  06,W
0160:  IORWF  77,W
0161:  MOVWF  06
....................   #endif 
....................        
....................    delay_cycles(1); 
0162:  NOP
....................    lcd_output_enable(1); 
0163:  BSF    06.0
....................    delay_us(2); 
0164:  GOTO   165
....................    lcd_output_enable(0); 
0165:  BCF    06.0
0166:  RETURN
.................... } 
