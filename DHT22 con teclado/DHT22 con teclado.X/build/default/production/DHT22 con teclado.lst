....................          case 0   : set_tris_kbd(ALL_PINS&~COL0); 
064D:  MOVLW  DE
064E:  BSF    03.5
064F:  MOVWF  06
....................                     kbd=~COL0&ALL_PINS; 
0650:  BCF    03.5
0651:  MOVWF  06
....................                     break; 
0652:  GOTO   65E
....................          case 1   : set_tris_kbd(ALL_PINS&~COL1); 
0653:  MOVLW  BE
0654:  BSF    03.5
0655:  MOVWF  06
