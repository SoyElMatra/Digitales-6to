.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
0167:  BSF    03.5
0168:  BCF    06.0
....................    lcd_rs_tris(); 
0169:  BCF    06.1
....................    lcd_rw_tris(); 
016A:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
016B:  BCF    03.5
016C:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
0196:  MOVF   78,W
0197:  MOVWF  6C
0198:  BTFSC  6C.7
0199:  GOTO   16D
....................    lcd_output_rs(address); 
019A:  BTFSS  6A.0
019B:  BCF    06.1
019C:  BTFSC  6A.0
019D:  BSF    06.1
....................    delay_cycles(1); 
019E:  NOP
....................    lcd_output_rw(0); 
019F:  BCF    06.2
....................    delay_cycles(1); 
01A0:  NOP
....................    lcd_output_enable(0); 
01A1:  BCF    06.0
....................    lcd_send_nibble(n >> 4); 
01A2:  SWAPF  6B,W
01A3:  MOVWF  6C
01A4:  MOVLW  0F
01A5:  ANDWF  6C,F
01A6:  MOVF   6C,W
01A7:  MOVWF  6D
01A8:  CALL   15B
