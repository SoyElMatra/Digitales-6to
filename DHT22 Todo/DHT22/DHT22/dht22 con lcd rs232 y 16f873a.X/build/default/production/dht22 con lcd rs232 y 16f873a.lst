....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
....................    n |= input(LCD_DATA5) << 1; 
....................    n |= input(LCD_DATA6) << 2; 
....................    n |= input(LCD_DATA7) << 3; 
....................     
....................    return(n); 
....................   #else 
....................    return(lcd.data); 
*
0036:  MOVF   06,W
0037:  MOVWF  20
0038:  SWAPF  06,W
0039:  ANDLW  0F
003A:  MOVWF  21
....................   #endif 
003B:  RETURN
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
....................   #else       
....................    lcdlat.data = n; 
*
0025:  SWAPF  50,W
0026:  ANDLW  F0
0027:  MOVWF  20
0028:  MOVLW  0F
0029:  ANDWF  06,W
002A:  IORWF  20,W
002B:  MOVWF  06
....................   #endif 
....................        
....................    delay_cycles(1); 
002C:  NOP
....................    lcd_output_enable(1); 
002D:  BSF    06.0
....................    delay_us(2); 
002E:  MOVLW  02
002F:  MOVWF  20
0030:  DECFSZ 20,F
0031:  GOTO   030
0032:  GOTO   033
0033:  NOP
....................    lcd_output_enable(0); 
0034:  BCF    06.0
0035:  RETURN
.................... } 
