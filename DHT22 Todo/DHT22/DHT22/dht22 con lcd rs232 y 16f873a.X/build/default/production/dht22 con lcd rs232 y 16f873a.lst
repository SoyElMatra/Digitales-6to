008F:  MOVWF  3D
0090:  MOVF   3D,W
0091:  SUBLW  03
0092:  BTFSS  03.0
0093:  GOTO   09C
....................    { 
....................        lcd_send_nibble(3); 
0094:  MOVLW  03
0095:  MOVWF  50
0096:  CALL   026
....................        delay_ms(5); 
0097:  MOVLW  05
0098:  MOVWF  4C
0099:  CALL   012
009A:  INCF   3D,F
009B:  GOTO   090
....................    } 
....................     
....................    lcd_send_nibble(2); 
009C:  MOVLW  02
009D:  MOVWF  50
009E:  CALL   026
....................    delay_ms(5); 
009F:  MOVLW  05
00A0:  MOVWF  4C
00A1:  CALL   012
....................    for(i=0;i<=3;++i) 
00A2:  CLRF   3D
00A3:  MOVF   3D,W
00A4:  SUBLW  03
00A5:  BTFSS  03.0
00A6:  GOTO   0B2
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
00A7:  MOVLW  3E
00A8:  ADDWF  3D,W
00A9:  MOVWF  04
00AA:  MOVF   00,W
00AB:  MOVWF  42
00AC:  CLRF   4D
00AD:  MOVF   42,W
00AE:  MOVWF  4E
00AF:  CALL   038
....................  
