.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
00CC:  MOVF   48,W
00CD:  XORLW  07
00CE:  BTFSC  03.2
00CF:  GOTO   0DA
00D0:  XORLW  0B
00D1:  BTFSC  03.2
00D2:  GOTO   0DF
