....................    output_drive(LCD_DATA4); 
....................    output_drive(LCD_DATA5); 
....................    output_drive(LCD_DATA6); 
....................    output_drive(LCD_DATA7); 
....................   #else 
....................    lcdtris.data = 0x0; 
0083:  MOVLW  0F
0084:  BSF    03.5
0085:  ANDWF  06,W
0086:  MOVWF  06
....................   #endif 
....................    lcd_enable_tris(); 
0087:  BCF    06.0
....................    lcd_rs_tris(); 
0088:  BCF    06.1
....................    lcd_rw_tris(); 
0089:  BCF    06.2
....................  #endif 
....................      
....................    delay_ms(15); 
008A:  MOVLW  0F
008B:  BCF    03.5
008C:  MOVWF  4C
008D:  CALL   012
....................    for(i=1;i<=3;++i) 
