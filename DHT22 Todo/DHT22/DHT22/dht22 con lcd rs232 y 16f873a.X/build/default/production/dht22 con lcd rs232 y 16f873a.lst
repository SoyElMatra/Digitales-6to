.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
012C:  MOVF   52,W
012D:  XORLW  07
012E:  BTFSC  03.2
012F:  GOTO   13A
0130:  XORLW  0B
0131:  BTFSC  03.2
0132:  GOTO   13F
0133:  XORLW  06
0134:  BTFSC  03.2
0135:  GOTO   147
0136:  XORLW  02
0137:  BTFSC  03.2
0138:  GOTO   14D
0139:  GOTO   152
