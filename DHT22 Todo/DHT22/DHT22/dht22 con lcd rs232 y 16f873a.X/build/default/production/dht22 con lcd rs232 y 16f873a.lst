00D7:  BTFSC  03.2
00D8:  GOTO   0ED
00D9:  GOTO   0F2
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
00DA:  MOVLW  01
00DB:  MOVWF  49
00DC:  MOVWF  4A
00DD:  CALL   0BA
00DE:  GOTO   0F7
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
00DF:  CLRF   4D
00E0:  MOVLW  01
00E1:  MOVWF  4E
00E2:  CALL   03C
....................                      delay_ms(2); 
