....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
....................    n |= input(LCD_DATA5) << 1; 
....................    n |= input(LCD_DATA6) << 2; 
....................    n |= input(LCD_DATA7) << 3; 
....................     
....................    return(n); 
....................   #else 
....................    return(lcd.data); 
*
0094:  MOVF   06,W
0095:  MOVWF  20
0096:  SWAPF  06,W
0097:  ANDLW  0F
0098:  MOVWF  21
....................   #endif 
0099:  RETURN
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
....................   #else       
....................    lcdlat.data = n; 
*
0083:  SWAPF  5A,W
0084:  ANDLW  F0
0085:  MOVWF  20
0086:  MOVLW  0F
0087:  ANDWF  06,W
0088:  IORWF  20,W
0089:  MOVWF  06
....................   #endif 
....................        
....................    delay_cycles(1); 
008A:  NOP
....................    lcd_output_enable(1); 
008B:  BSF    06.0
....................    delay_us(2); 
008C:  MOVLW  02
008D:  MOVWF  20
008E:  DECFSZ 20,F
008F:  GOTO   08E
0090:  GOTO   091
0091:  NOP
....................    lcd_output_enable(0); 
0092:  BCF    06.0
0093:  RETURN
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
009A:  BSF    03.5
009B:  BCF    06.0
....................    lcd_rs_tris(); 
009C:  BCF    06.1
....................    lcd_rw_tris(); 
009D:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
009E:  BCF    03.5
009F:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
00C3:  MOVF   21,W
00C4:  MOVWF  59
00C5:  BTFSC  59.7
00C6:  GOTO   0A0
....................    lcd_output_rs(address); 
00C7:  BTFSS  57.0
00C8:  BCF    06.1
00C9:  BTFSC  57.0
00CA:  BSF    06.1
....................    delay_cycles(1); 
00CB:  NOP
....................    lcd_output_rw(0); 
00CC:  BCF    06.2
....................    delay_cycles(1); 
00CD:  NOP
....................    lcd_output_enable(0); 
00CE:  BCF    06.0
....................    lcd_send_nibble(n >> 4); 
00CF:  SWAPF  58,W
00D0:  MOVWF  59
00D1:  MOVLW  0F
00D2:  ANDWF  59,F
00D3:  MOVF   59,W
00D4:  MOVWF  5A
00D5:  CALL   083
....................    lcd_send_nibble(n & 0xf); 
00D6:  MOVF   58,W
00D7:  ANDLW  0F
00D8:  MOVWF  59
00D9:  MOVWF  5A
00DA:  CALL   083
00DB:  RETURN
.................... } 
