....................    lcd_output_rs(0); 
0040:  BCF    03.5
0041:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
0065:  MOVF   21,W
0066:  MOVWF  4F
0067:  BTFSC  4F.7
0068:  GOTO   042
....................    lcd_output_rs(address); 
0069:  BTFSS  4D.0
006A:  BCF    06.1
006B:  BTFSC  4D.0
006C:  BSF    06.1
....................    delay_cycles(1); 
006D:  NOP
....................    lcd_output_rw(0); 
006E:  BCF    06.2
....................    delay_cycles(1); 
006F:  NOP
....................    lcd_output_enable(0); 
0070:  BCF    06.0
....................    lcd_send_nibble(n >> 4); 
0071:  SWAPF  4E,W
0072:  MOVWF  4F
