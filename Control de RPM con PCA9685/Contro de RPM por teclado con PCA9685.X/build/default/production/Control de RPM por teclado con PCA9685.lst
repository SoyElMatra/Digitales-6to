....................  
.................... ////////////////// The following defines the keypad layout on port D 
....................  
.................... // Un-comment the following define to use port B 
.................... // #define use_portb_kbd TRUE 
....................  
.................... // Make sure the port used has pull-up resistors (or the LCD) on 
.................... // the column pins 
....................  
.................... #if defined use_portb_kbd 
....................    #byte kbd = getenv("SFR:PORTB") 
.................... #else 
....................    #byte kbd = getenv("SFR:PORTD") 
.................... #endif 
....................  
.................... #if defined use_portb_kbd 
....................    #define set_tris_kbd(x) set_tris_b(x) 
.................... #else 
....................    #define set_tris_kbd(x) set_tris_d(x) 
.................... #endif 
....................  
.................... //Keypad connection:   (for example column 0 is B2) 
.................... //                Bx: 
....................  
.................... #ifdef blue_keypad  ///////////////////////////////////// For the blue keypad 
.................... #define COL0 (1 << 2) 
.................... #define COL1 (1 << 3) 
.................... #define COL2 (1 << 6) 
....................  
.................... #define ROW0 (1 << 4) 
.................... #define ROW1 (1 << 7) 
.................... #define ROW2 (1 << 1) 
.................... #define ROW3 (1 << 5) 
....................  
.................... #else ////////////////////////////////////////////////// For the black keypad 
.................... #define COL0 (1 << 5) 
.................... #define COL1 (1 << 6) 
.................... #define COL2 (1 << 7) 
....................  
.................... #define ROW0 (1 << 1) 
.................... #define ROW1 (1 << 2) 
.................... #define ROW2 (1 << 3) 
.................... #define ROW3 (1 << 4) 
....................  
.................... #endif 
....................  
.................... #define ALL_ROWS (ROW0|ROW1|ROW2|ROW3) 
.................... #define ALL_PINS (ALL_ROWS|COL0|COL1|COL2) 
....................  
.................... // Keypad layout: 
.................... char const KEYS[4][3] = {{'1','2','3'}, 
....................                          {'4','5','6'}, 
....................                          {'7','8','9'}, 
....................                          {'*','0','#'}}; 
....................  
.................... #define KBD_DEBOUNCE_FACTOR 33    // Set this number to apx n/333 where 
....................                                   // n is the number of times you expect 
....................                                   // to call kbd_getc each second 
....................  
....................  
.................... void kbd_init() { 
*
0312:  BCF    0A.3
0313:  BCF    0A.4
0314:  GOTO   4C2 (RETURN)
.................... } 
....................  
.................... char kbd_getc( ) { 
....................    static BYTE kbd_call_count; 
*
04B2:  BCF    03.5
04B3:  CLRF   2D
....................    static int1 kbd_down; 
04B4:  BCF    2E.0
....................    static char last_key; 
04B5:  CLRF   2F
....................    static BYTE col; 
04B6:  CLRF   30
04B7:  CLRF   2B
04B8:  BTFSC  0B.7
04B9:  BSF    2B.7
04BA:  BCF    0B.7
....................  
....................    BYTE kchar; 
....................    BYTE row; 
....................  
....................    kchar='\0'; 
*
0410:  CLRF   38
....................    if(++kbd_call_count>KBD_DEBOUNCE_FACTOR) { 
0411:  INCF   2D,F
0412:  MOVF   2D,W
0413:  SUBLW  21
0414:  BTFSC  03.0
0415:  GOTO   491
....................        switch (col) { 
0416:  MOVF   30,W
0417:  BTFSC  03.2
0418:  GOTO   420
0419:  XORLW  01
041A:  BTFSC  03.2
041B:  GOTO   426
041C:  XORLW  03
041D:  BTFSC  03.2
041E:  GOTO   42C
041F:  GOTO   431
....................          case 0   : set_tris_kbd(ALL_PINS&~COL0); 
0420:  MOVLW  DE
0421:  BSF    03.5
0422:  MOVWF  06
....................                     kbd=~COL0&ALL_PINS; 
0423:  BCF    03.5
0424:  MOVWF  06
....................                     break; 
0425:  GOTO   431
....................          case 1   : set_tris_kbd(ALL_PINS&~COL1); 
0426:  MOVLW  BE
0427:  BSF    03.5
0428:  MOVWF  06
....................                     kbd=~COL1&ALL_PINS; 
0429:  BCF    03.5
042A:  MOVWF  06
....................                     break; 
042B:  GOTO   431
....................          case 2   : set_tris_kbd(ALL_PINS&~COL2); 
042C:  MOVLW  7E
042D:  BSF    03.5
042E:  MOVWF  06
....................                     kbd=~COL2&ALL_PINS; 
042F:  BCF    03.5
0430:  MOVWF  06
....................                     break; 
....................        } 
....................  
....................        if(kbd_down) { 
0431:  BTFSS  2E.0
0432:  GOTO   43D
....................          if((kbd & (ALL_ROWS))==(ALL_ROWS)) { 
0433:  MOVF   06,W
0434:  ANDLW  1E
0435:  SUBLW  1E
0436:  BTFSS  03.2
0437:  GOTO   43C
....................            kbd_down=FALSE; 
0438:  BCF    2E.0
....................            kchar=last_key; 
0439:  MOVF   2F,W
043A:  MOVWF  38
....................            last_key='\0'; 
043B:  CLRF   2F
....................          } 
....................        } else { 
043C:  GOTO   490
....................           if((kbd & (ALL_ROWS))!=(ALL_ROWS)) { 
043D:  MOVF   06,W
043E:  ANDLW  1E
043F:  SUBLW  1E
0440:  BTFSC  03.2
0441:  GOTO   48B
....................              if((kbd & ROW0)==0) 
0442:  MOVF   06,W
0443:  ANDLW  02
0444:  BTFSS  03.2
0445:  GOTO   448
....................                row=0; 
0446:  CLRF   39
0447:  GOTO   45C
....................              else if((kbd & ROW1)==0) 
0448:  MOVF   06,W
0449:  ANDLW  04
044A:  BTFSS  03.2
044B:  GOTO   44F
....................                row=1; 
044C:  MOVLW  01
044D:  MOVWF  39
044E:  GOTO   45C
....................              else if((kbd & ROW2)==0) 
044F:  MOVF   06,W
0450:  ANDLW  08
0451:  BTFSS  03.2
0452:  GOTO   456
....................                row=2; 
0453:  MOVLW  02
0454:  MOVWF  39
0455:  GOTO   45C
....................              else if((kbd & ROW3)==0) 
0456:  MOVF   06,W
0457:  ANDLW  10
0458:  BTFSS  03.2
0459:  GOTO   45C
....................                row=3; 
045A:  MOVLW  03
045B:  MOVWF  39
....................              last_key =KEYS[row][col]; 
045C:  MOVF   39,W
045D:  MOVWF  3A
045E:  MOVLW  03
045F:  MOVWF  3B
*
0484:  MOVF   30,W
0485:  ADDWF  78,W
0486:  CALL   051
0487:  MOVWF  78
0488:  MOVWF  2F
....................              kbd_down = TRUE; 
0489:  BSF    2E.0
....................           } else { 
048A:  GOTO   490
....................              ++col; 
048B:  INCF   30,F
....................              if(col==3) 
048C:  MOVF   30,W
048D:  SUBLW  03
048E:  BTFSC  03.2
....................                col=0; 
048F:  CLRF   30
....................           } 
....................        } 
....................       kbd_call_count=0; 
0490:  CLRF   2D
....................    } 
....................   set_tris_kbd(ALL_PINS); 
0491:  MOVLW  FE
0492:  BSF    03.5
0493:  MOVWF  06
....................   return(kchar); 
0494:  BCF    03.5
0495:  MOVF   38,W
0496:  MOVWF  78
0497:  RETURN
.................... } 
....................  
.................... #use standard_io(A) 
.................... #use standard_io(B) 
....................  
.................... #define PCA9685_ADDR 0x80  // Dirección I2C  
....................  
.................... int16 contador=0, ancho=0; 
.................... int valor, rpm; 
.................... int1 flagmedida=0; 
.................... char k; 
....................  
.................... void cambiar_veloc (void){ 
....................     disable_interrupts(INT_TIMER1); 
*
0521:  BSF    03.5
0522:  BCF    0C.0
....................      set_pwm1_duty(0);   
0523:  BCF    03.5
0524:  CLRF   15
....................   lcd_putc("\fIngrese\n"); 
0525:  MOVLW  61
0526:  BSF    03.6
0527:  MOVWF  0D
0528:  MOVLW  00
0529:  MOVWF  0F
.................... 		  printf(lcd_putc,"Valor.RPM (   )"); 
*
0589:  MOVLW  66
058A:  MOVWF  0D
058B:  MOVLW  00
058C:  MOVWF  0F
....................            k=kbd_getc(); 				      //devuelve la tecla pulsada si no se apreta ninguna tecla devuelve el 0 en decimal 
*
05EC:  BCF    03.6
05ED:  CALL   410
05EE:  MOVF   78,W
05EF:  MOVWF  37
....................           while(K!='1'&k!='0') 
05F0:  MOVF   37,W
05F1:  SUBLW  31
05F2:  BTFSS  03.2
05F3:  GOTO   5F6
05F4:  MOVLW  00
05F5:  GOTO   5F7
05F6:  MOVLW  01
05F7:  MOVWF  38
05F8:  MOVF   37,W
05F9:  SUBLW  30
05FA:  BTFSS  03.2
05FB:  GOTO   5FE
05FC:  MOVLW  00
05FD:  GOTO   5FF
05FE:  MOVLW  01
05FF:  ANDWF  38,W
0600:  BTFSC  03.2
0601:  GOTO   606
.................... 		{ 
.................... 			k=kbd_getc(); 
0602:  CALL   410
0603:  MOVF   78,W
0604:  MOVWF  37
0605:  GOTO   5F0
0606:  CLRF   2B
0607:  BTFSC  0B.7
0608:  BSF    2B.7
0609:  BCF    0B.7
.................... 		} 
.................... 			 
.................... 		    lcd_gotoxy(12,2); 
060A:  MOVLW  0C
060B:  MOVWF  4F
060C:  MOVLW  02
060D:  MOVWF  50
060E:  CALL   0CB
060F:  BTFSC  2B.7
0610:  BSF    0B.7
0611:  CLRF   2B
0612:  BTFSC  0B.7
0613:  BSF    2B.7
0614:  BCF    0B.7
....................             printf(lcd_putc,"%c",k); 
0615:  MOVF   37,W
0616:  MOVWF  4E
