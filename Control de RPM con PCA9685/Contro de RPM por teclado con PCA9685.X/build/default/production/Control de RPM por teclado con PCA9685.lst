.................... // --- Funciones para escribir en el PCA9685 --- 
.................... void pca9685_write_byte(int8 reg, int8 data) { 
....................    i2c_start(); 
*
035F:  BSF    2C.4
0360:  MOVF   2C,W
0361:  BSF    03.5
0362:  MOVWF  07
0363:  NOP
0364:  BCF    03.5
0365:  BSF    2C.3
0366:  MOVF   2C,W
0367:  BSF    03.5
0368:  MOVWF  07
0369:  NOP
036A:  BCF    03.5
036B:  BCF    07.4
036C:  BCF    2C.4
036D:  MOVF   2C,W
036E:  BSF    03.5
036F:  MOVWF  07
0370:  NOP
0371:  BCF    03.5
0372:  BCF    07.3
0373:  BCF    2C.3
0374:  MOVF   2C,W
0375:  BSF    03.5
0376:  MOVWF  07
....................    i2c_write(PCA9685_ADDR); 
0377:  MOVLW  80
0378:  BCF    03.5
0379:  MOVWF  40
037A:  CALL   315
....................    i2c_write(reg); 
037B:  MOVF   38,W
037C:  MOVWF  40
037D:  CALL   315
....................    i2c_write(data); 
037E:  MOVF   39,W
037F:  MOVWF  40
0380:  CALL   315
....................    i2c_stop(); 
0381:  BCF    2C.4
0382:  MOVF   2C,W
0383:  BSF    03.5
0384:  MOVWF  07
0385:  NOP
0386:  BCF    03.5
0387:  BSF    2C.3
0388:  MOVF   2C,W
0389:  BSF    03.5
038A:  MOVWF  07
038B:  BCF    03.5
038C:  BTFSS  07.3
038D:  GOTO   38C
038E:  NOP
038F:  GOTO   390
0390:  NOP
0391:  BSF    2C.4
0392:  MOVF   2C,W
0393:  BSF    03.5
0394:  MOVWF  07
0395:  NOP
0396:  BCF    03.5
0397:  RETURN
.................... } 
....................  
.................... void pca9685_set_pwm(int8 channel, int16 on, int16 off) { 
*
03BA:  RLF    38,W
03BB:  MOVWF  77
03BC:  RLF    77,F
03BD:  MOVLW  FC
03BE:  ANDWF  77,F
03BF:  MOVF   77,W
03C0:  ADDLW  06
03C1:  MOVWF  3D
....................    int8 base_reg = 0x06 + 4 * channel; 
....................    i2c_start(); 
03C2:  BSF    2C.4
03C3:  MOVF   2C,W
03C4:  BSF    03.5
03C5:  MOVWF  07
03C6:  NOP
03C7:  BCF    03.5
03C8:  BSF    2C.3
03C9:  MOVF   2C,W
03CA:  BSF    03.5
03CB:  MOVWF  07
03CC:  NOP
03CD:  BCF    03.5
03CE:  BCF    07.4
03CF:  BCF    2C.4
03D0:  MOVF   2C,W
03D1:  BSF    03.5
03D2:  MOVWF  07
03D3:  NOP
03D4:  BCF    03.5
03D5:  BCF    07.3
03D6:  BCF    2C.3
03D7:  MOVF   2C,W
03D8:  BSF    03.5
03D9:  MOVWF  07
....................    i2c_write(PCA9685_ADDR); 
03DA:  MOVLW  80
03DB:  BCF    03.5
03DC:  MOVWF  40
03DD:  CALL   315
....................    i2c_write(base_reg); 
03DE:  MOVF   3D,W
03DF:  MOVWF  40
03E0:  CALL   315
....................    i2c_write(on & 0xFF); 
03E1:  MOVF   39,W
03E2:  MOVWF  3E
03E3:  CLRF   3F
03E4:  MOVF   39,W
03E5:  MOVWF  40
03E6:  CALL   315
....................    i2c_write(on >> 8); 
03E7:  MOVF   3A,W
03E8:  MOVWF  3E
03E9:  CLRF   3F
03EA:  MOVF   3A,W
03EB:  MOVWF  40
03EC:  CALL   315
....................    i2c_write(off & 0xFF); 
03ED:  MOVF   3B,W
03EE:  MOVWF  3E
03EF:  CLRF   3F
03F0:  MOVF   3B,W
03F1:  MOVWF  40
03F2:  CALL   315
....................    i2c_write(off >> 8); 
03F3:  MOVF   3C,W
03F4:  MOVWF  3E
03F5:  CLRF   3F
03F6:  MOVF   3C,W
03F7:  MOVWF  40
03F8:  CALL   315
....................    i2c_stop(); 
03F9:  BCF    2C.4
03FA:  MOVF   2C,W
03FB:  BSF    03.5
03FC:  MOVWF  07
03FD:  NOP
03FE:  BCF    03.5
03FF:  BSF    2C.3
0400:  MOVF   2C,W
0401:  BSF    03.5
0402:  MOVWF  07
0403:  BCF    03.5
0404:  BTFSS  07.3
0405:  GOTO   404
0406:  NOP
0407:  GOTO   408
0408:  NOP
0409:  BSF    2C.4
040A:  MOVF   2C,W
040B:  BSF    03.5
040C:  MOVWF  07
040D:  NOP
040E:  BCF    03.5
040F:  RETURN
.................... } 
....................  
.................... void pca9685_init() { 
....................    pca9685_write_byte(0x00, 0x30);//b'00110000' Autoincremento de registros y modo sleep para poder configurar la frecuencia 
*
0398:  CLRF   38
0399:  MOVLW  30
039A:  MOVWF  39
039B:  CALL   35F
039C:  CLRF   2B
039D:  BTFSC  0B.7
039E:  BSF    2B.7
039F:  BCF    0B.7
....................    delay_ms(10); 
03A0:  MOVLW  0A
03A1:  MOVWF  4F
03A2:  CALL   0DD
03A3:  BTFSC  2B.7
03A4:  BSF    0B.7
....................    pca9685_write_byte(0xFE, 0x17);   // Prescaler para 50Hz approx 25.000000/(4096*200)-1=29=0x17 
03A5:  MOVLW  FE
03A6:  MOVWF  38
03A7:  MOVLW  17
03A8:  MOVWF  39
03A9:  CALL   35F
03AA:  CLRF   2B
03AB:  BTFSC  0B.7
03AC:  BSF    2B.7
03AD:  BCF    0B.7
....................    delay_ms(10); 
03AE:  MOVLW  0A
03AF:  MOVWF  4F
03B0:  CALL   0DD
03B1:  BTFSC  2B.7
03B2:  BSF    0B.7
....................    pca9685_write_byte(0x00, 0xA1);   // Auto-incremento activado 
03B3:  CLRF   38
03B4:  MOVLW  A1
03B5:  MOVWF  39
03B6:  CALL   35F
03B7:  BCF    0A.3
03B8:  BCF    0A.4
03B9:  GOTO   4D2 (RETURN)
.................... } 
