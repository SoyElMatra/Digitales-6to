04CC:  CLRF   0E
04CD:  MOVLW  E7
04CE:  MOVWF  0F
04CF:  MOVLW  96
04D0:  MOVWF  0E
....................    pca9685_init();     // Inicializar PCA9685 
04D1:  GOTO   398
....................      pca9685_set_pwm(0, 0, ancho);   // Canal 0: PWM Duty 0 
04D2:  CLRF   38
04D3:  CLRF   3A
04D4:  CLRF   39
04D5:  MOVF   34,W
04D6:  MOVWF  3C
04D7:  MOVF   33,W
04D8:  MOVWF  3B
04D9:  CALL   3BA
....................      enable_interrupts(int_timer1); 
04DA:  BSF    03.5
04DB:  BSF    0C.0
....................    enable_interrupts(global);           //Habilitación interrupci 
04DC:  MOVLW  C0
04DD:  BCF    03.5
04DE:  IORWF  0B,F
....................    valor=read_eeprom(0x00); 
04DF:  BSF    03.6
