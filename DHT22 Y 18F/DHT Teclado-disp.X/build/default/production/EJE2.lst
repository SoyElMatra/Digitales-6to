04F6:  MOVWF  00
04F8:  MOVLW  0F
04FA:  ANDWF  F8A,W
04FC:  IORWF  00,W
04FE:  MOVWF  F8A
....................   #endif 
....................        
....................    delay_cycles(1); 
0500:  NOP   
....................    lcd_output_enable(1); 
0502:  BSF    F8A.0
....................    delay_us(2); 
0504:  BRA    0506
....................    lcd_output_enable(0); 
0506:  BCF    F8A.0
0508:  RETURN 0
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
050A:  BCF    F93.0
....................    lcd_rs_tris(); 
050C:  BCF    F93.1
....................    lcd_rw_tris(); 
050E:  BCF    F93.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
0510:  BCF    F8A.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
0512:  RCALL  04B6
0514:  MOVFF  01,5E
0518:  BTFSC  01.7
