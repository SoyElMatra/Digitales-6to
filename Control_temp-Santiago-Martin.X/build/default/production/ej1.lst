....................  
.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
*
04B1:  MOVLW  28
04B2:  MOVWF  3F
04B3:  MOVLW  0C
04B4:  MOVWF  40
04B5:  MOVLW  01
04B6:  MOVWF  41
04B7:  MOVLW  06
04B8:  MOVWF  42
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
04B9:  BCF    06.0
....................    lcd_output_rs(0); 
04BA:  BCF    06.1
....................    lcd_output_rw(0); 
04BB:  BCF    06.2
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
....................    output_drive(LCD_DATA5); 
....................    output_drive(LCD_DATA6); 
....................    output_drive(LCD_DATA7); 
....................   #else 
....................    lcdtris.data = 0x0; 
04BC:  MOVLW  0F
04BD:  BSF    03.5
04BE:  ANDWF  06,W
04BF:  MOVWF  06
....................   #endif 
....................    lcd_enable_tris(); 
04C0:  BCF    06.0
....................    lcd_rs_tris(); 
04C1:  BCF    06.1
....................    lcd_rw_tris(); 
04C2:  BCF    06.2
04C3:  BCF    03.5
04C4:  CLRF   2B
04C5:  BTFSC  0B.7
04C6:  BSF    2B.7
04C7:  BCF    0B.7
....................  #endif 
....................      
....................    delay_ms(15); 
04C8:  MOVLW  0F
04C9:  MOVWF  5B
04CA:  CALL   289
04CB:  BTFSC  2B.7
04CC:  BSF    0B.7
....................    for(i=1;i<=3;++i) 
04CD:  MOVLW  01
04CE:  MOVWF  3E
04CF:  MOVF   3E,W
04D0:  SUBLW  03
04D1:  BTFSS  03.0
04D2:  GOTO   4EB
....................    { 
....................        lcd_send_nibble(3); 
04D3:  MOVLW  03
04D4:  MOVWF  62
....................        delay_ms(5); 
*
04E4:  MOVLW  05
04E5:  MOVWF  5B
04E6:  CALL   289
04E7:  BTFSC  2B.7
04E8:  BSF    0B.7
04E9:  INCF   3E,F
04EA:  GOTO   4CF
....................    } 
....................     
....................    lcd_send_nibble(2); 
04EB:  MOVLW  02
04EC:  MOVWF  62
....................    delay_ms(5); 
*
04FC:  MOVLW  05
04FD:  MOVWF  5B
04FE:  CALL   289
04FF:  BTFSC  2B.7
0500:  BSF    0B.7
....................    for(i=0;i<=3;++i) 
0501:  CLRF   3E
0502:  MOVF   3E,W
0503:  SUBLW  03
0504:  BTFSS  03.0
0505:  GOTO   56D
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
0506:  MOVLW  3F
0507:  ADDWF  3E,W
0508:  MOVWF  04
0509:  BCF    03.7
050A:  MOVF   00,W
050B:  MOVWF  43
050C:  CLRF   5F
050D:  MOVF   43,W
050E:  MOVWF  60
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
*
056B:  INCF   3E,F
056C:  GOTO   502
056D:  BSF    0A.3
056E:  BCF    0A.4
056F:  GOTO   688 (RETURN)
....................    g_LcdX = 0; 
....................    g_LcdY = 0; 
....................   #endif 
.................... } 
....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
*
021C:  DECFSZ 5C,W
021D:  GOTO   21F
021E:  GOTO   222
....................       address=LCD_LINE_TWO; 
021F:  MOVLW  40
0220:  MOVWF  5D
0221:  GOTO   223
....................    else 
....................       address=0; 
0222:  CLRF   5D
....................       
....................    address+=x-1; 
0223:  MOVLW  01
0224:  SUBWF  5B,W
0225:  ADDWF  5D,F
....................    lcd_send_byte(0,0x80|address); 
0226:  MOVF   5D,W
0227:  IORLW  80
0228:  MOVWF  5E
0229:  CLRF   5F
022A:  MOVF   5E,W
022B:  MOVWF  60
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
*
0288:  RETURN
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
*
029E:  MOVF   5A,W
029F:  XORLW  07
02A0:  BTFSC  03.2
02A1:  GOTO   2AC
02A2:  XORLW  0B
02A3:  BTFSC  03.2
02A4:  GOTO   2B1
