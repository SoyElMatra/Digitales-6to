0109:  MOVWF  4C
010A:  CALL   09A
....................        delay_ms(5); 
010B:  MOVLW  05
010C:  MOVWF  45
010D:  CALL   085
010E:  INCF   3B,F
010F:  GOTO   104
....................    } 
....................     
....................    lcd_send_nibble(2); 
0110:  MOVLW  02
0111:  MOVWF  4C
0112:  CALL   09A
....................    delay_ms(5); 
0113:  MOVLW  05
0114:  MOVWF  45
0115:  CALL   085
....................    for(i=0;i<=3;++i) 
0116:  CLRF   3B
0117:  MOVF   3B,W
0118:  SUBLW  03
0119:  BTFSS  03.0
011A:  GOTO   127
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
011B:  MOVLW  3C
011C:  ADDWF  3B,W
011D:  MOVWF  04
011E:  BCF    03.7
011F:  MOVF   00,W
0120:  MOVWF  40
0121:  CLRF   49
0122:  MOVF   40,W
0123:  MOVWF  4A
0124:  CALL   0AC
