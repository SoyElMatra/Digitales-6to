....................    output_drive(LCD_DATA4); 
....................    output_drive(LCD_DATA5); 
....................    output_drive(LCD_DATA6); 
....................    output_drive(LCD_DATA7); 
....................   #else 
....................    lcdtris.data = 0x0; 
00F7:  MOVLW  0F
00F8:  BSF    03.5
00F9:  ANDWF  06,W
00FA:  MOVWF  06
....................   #endif 
....................    lcd_enable_tris(); 
00FB:  BCF    06.0
....................    lcd_rs_tris(); 
00FC:  BCF    06.1
....................    lcd_rw_tris(); 
00FD:  BCF    06.2
....................  #endif 
....................      
....................    delay_ms(15); 
00FE:  MOVLW  0F
00FF:  BCF    03.5
0100:  MOVWF  45
0101:  CALL   085
....................    for(i=1;i<=3;++i) 
