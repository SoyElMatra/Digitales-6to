....................    else 
....................       address=0; 
0133:  CLRF   47
....................       
....................    address+=x-1; 
0134:  MOVLW  01
0135:  SUBWF  45,W
0136:  ADDWF  47,F
....................    lcd_send_byte(0,0x80|address); 
0137:  MOVF   47,W
0138:  IORLW  80
0139:  MOVWF  48
013A:  CLRF   49
013B:  MOVF   48,W
013C:  MOVWF  4A
