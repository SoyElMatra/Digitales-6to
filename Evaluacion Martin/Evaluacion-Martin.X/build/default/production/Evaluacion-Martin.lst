.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
00EC:  MOVLW  28
00ED:  MOVWF  3C
00EE:  MOVLW  0C
00EF:  MOVWF  3D
00F0:  MOVLW  01
00F1:  MOVWF  3E
00F2:  MOVLW  06
00F3:  MOVWF  3F
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
00F4:  BCF    06.0
....................    lcd_output_rs(0); 
00F5:  BCF    06.1
....................    lcd_output_rw(0); 
00F6:  BCF    06.2
....................  
