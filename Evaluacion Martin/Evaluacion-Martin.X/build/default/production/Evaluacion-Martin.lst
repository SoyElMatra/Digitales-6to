.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
00EC:  MOVLW  28
00ED:  MOVWF  3C
00EE:  MOVLW  0C
00EF:  MOVWF  3D
00F0:  MOVLW  01
00F1:  MOVWF  3E
00F2:  MOVLW  06
00F3:  MOVWF  3F
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
00F4:  BCF    06.0
....................    lcd_output_rs(0); 
00F5:  BCF    06.1
....................    lcd_output_rw(0); 
00F6:  BCF    06.2
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
....................    output_drive(LCD_DATA5); 
....................    output_drive(LCD_DATA6); 
....................    output_drive(LCD_DATA7); 
....................   #else 
....................    lcdtris.data = 0x0; 
00F7:  MOVLW  0F
00F8:  BSF    03.5
00F9:  ANDWF  06,W
00FA:  MOVWF  06
....................   #endif 
....................    lcd_enable_tris(); 
00FB:  BCF    06.0
....................    lcd_rs_tris(); 
00FC:  BCF    06.1
....................    lcd_rw_tris(); 
00FD:  BCF    06.2
....................  #endif 
....................      
....................    delay_ms(15); 
00FE:  MOVLW  0F
00FF:  BCF    03.5
0100:  MOVWF  45
0101:  CALL   085
....................    for(i=1;i<=3;++i) 
0102:  MOVLW  01
0103:  MOVWF  3B
0104:  MOVF   3B,W
0105:  SUBLW  03
0106:  BTFSS  03.0
0107:  GOTO   110
....................    { 
....................        lcd_send_nibble(3); 
0108:  MOVLW  03
0109:  MOVWF  4C
010A:  CALL   09A
....................        delay_ms(5); 
010B:  MOVLW  05
010C:  MOVWF  45
010D:  CALL   085
010E:  INCF   3B,F
010F:  GOTO   104
....................    } 
....................     
....................    lcd_send_nibble(2); 
0110:  MOVLW  02
0111:  MOVWF  4C
0112:  CALL   09A
....................    delay_ms(5); 
0113:  MOVLW  05
0114:  MOVWF  45
0115:  CALL   085
....................    for(i=0;i<=3;++i) 
0116:  CLRF   3B
0117:  MOVF   3B,W
0118:  SUBLW  03
0119:  BTFSS  03.0
011A:  GOTO   127
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
011B:  MOVLW  3C
011C:  ADDWF  3B,W
011D:  MOVWF  04
011E:  BCF    03.7
011F:  MOVF   00,W
0120:  MOVWF  40
0121:  CLRF   49
0122:  MOVF   40,W
0123:  MOVWF  4A
0124:  CALL   0AC
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
0125:  INCF   3B,F
0126:  GOTO   117
0127:  BCF    0A.3
0128:  BCF    0A.4
0129:  GOTO   517 (RETURN)
....................    g_LcdX = 0; 
....................    g_LcdY = 0; 
....................   #endif 
