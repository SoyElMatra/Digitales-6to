....................  
.................... ////////////////// The following defines the keypad layout on port D 
....................  
.................... // Un-comment the following define to use port B 
.................... // #define use_portb_kbd TRUE 
....................  
.................... // Make sure the port used has pull-up resistors (or the LCD) on 
.................... // the column pins 
....................  
.................... #if defined use_portb_kbd 
....................    #byte kbd = getenv("SFR:PORTB") 
.................... #else 
....................    #byte kbd = getenv("SFR:PORTD") 
.................... #endif 
....................  
.................... #if defined use_portb_kbd 
....................    #define set_tris_kbd(x) set_tris_b(x) 
.................... #else 
....................    #define set_tris_kbd(x) set_tris_d(x) 
.................... #endif 
....................  
.................... //Keypad connection:   (for example column 0 is B2) 
.................... //                Bx: 
....................  
.................... #ifdef blue_keypad  ///////////////////////////////////// For the blue keypad 
.................... #define COL0 (1 << 2) 
.................... #define COL1 (1 << 3) 
.................... #define COL2 (1 << 6) 
....................  
.................... #define ROW0 (1 << 4) 
.................... #define ROW1 (1 << 7) 
.................... #define ROW2 (1 << 1) 
.................... #define ROW3 (1 << 5) 
....................  
.................... #else ////////////////////////////////////////////////// For the black keypad 
.................... #define COL0 (1 << 5) 
.................... #define COL1 (1 << 6) 
.................... #define COL2 (1 << 7) 
....................  
.................... #define ROW0 (1 << 1) 
.................... #define ROW1 (1 << 2) 
.................... #define ROW2 (1 << 3) 
.................... #define ROW3 (1 << 4) 
....................  
.................... #endif 
....................  
.................... #define ALL_ROWS (ROW0|ROW1|ROW2|ROW3) 
.................... #define ALL_PINS (ALL_ROWS|COL0|COL1|COL2) 
....................  
.................... // Keypad layout: 
.................... char const KEYS[4][3] = {{'1','2','3'}, 
....................                          {'4','5','6'}, 
....................                          {'7','8','9'}, 
....................                          {'*','0','#'}}; 
....................  
.................... #define KBD_DEBOUNCE_FACTOR 33    // Set this number to apx n/333 where 
....................                                   // n is the number of times you expect 
....................                                   // to call kbd_getc each second 
....................  
....................  
.................... void kbd_init() { 
*
012A:  BCF    0A.3
012B:  BCF    0A.4
012C:  GOTO   547 (RETURN)
.................... } 
....................  
.................... char kbd_getc( ) { 
....................    static BYTE kbd_call_count; 
*
052D:  BCF    03.5
052E:  CLRF   2C
....................    static int1 kbd_down; 
052F:  BCF    2D.0
....................    static char last_key; 
0530:  CLRF   2E
....................    static BYTE col; 
0531:  CLRF   2F
....................  
....................    BYTE kchar; 
....................    BYTE row; 
....................  
....................    kchar='\0'; 
*
01E6:  CLRF   3B
....................    if(++kbd_call_count>KBD_DEBOUNCE_FACTOR) { 
01E7:  INCF   2C,F
01E8:  MOVF   2C,W
01E9:  SUBLW  21
01EA:  BTFSC  03.0
01EB:  GOTO   244
....................        switch (col) { 
01EC:  MOVF   2F,W
01ED:  BTFSC  03.2
01EE:  GOTO   1F6
01EF:  XORLW  01
01F0:  BTFSC  03.2
01F1:  GOTO   1FC
01F2:  XORLW  03
01F3:  BTFSC  03.2
01F4:  GOTO   202
01F5:  GOTO   207
....................          case 0   : set_tris_kbd(ALL_PINS&~COL0); 
01F6:  MOVLW  DE
01F7:  BSF    03.5
01F8:  MOVWF  06
....................                     kbd=~COL0&ALL_PINS; 
01F9:  BCF    03.5
01FA:  MOVWF  06
....................                     break; 
01FB:  GOTO   207
....................          case 1   : set_tris_kbd(ALL_PINS&~COL1); 
01FC:  MOVLW  BE
01FD:  BSF    03.5
01FE:  MOVWF  06
....................                     kbd=~COL1&ALL_PINS; 
01FF:  BCF    03.5
0200:  MOVWF  06
....................                     break; 
0201:  GOTO   207
....................          case 2   : set_tris_kbd(ALL_PINS&~COL2); 
0202:  MOVLW  7E
0203:  BSF    03.5
0204:  MOVWF  06
....................                     kbd=~COL2&ALL_PINS; 
0205:  BCF    03.5
0206:  MOVWF  06
....................                     break; 
....................        } 
....................  
....................        if(kbd_down) { 
0207:  BTFSS  2D.0
0208:  GOTO   213
....................          if((kbd & (ALL_ROWS))==(ALL_ROWS)) { 
0209:  MOVF   06,W
020A:  ANDLW  1E
020B:  SUBLW  1E
020C:  BTFSS  03.2
020D:  GOTO   212
....................            kbd_down=FALSE; 
020E:  BCF    2D.0
....................            kchar=last_key; 
020F:  MOVF   2E,W
0210:  MOVWF  3B
....................            last_key='\0'; 
0211:  CLRF   2E
....................          } 
....................        } else { 
0212:  GOTO   243
....................           if((kbd & (ALL_ROWS))!=(ALL_ROWS)) { 
0213:  MOVF   06,W
0214:  ANDLW  1E
0215:  SUBLW  1E
0216:  BTFSC  03.2
0217:  GOTO   23E
....................              if((kbd & ROW0)==0) 
0218:  MOVF   06,W
0219:  ANDLW  02
021A:  BTFSS  03.2
021B:  GOTO   21E
....................                row=0; 
021C:  CLRF   3C
021D:  GOTO   232
....................              else if((kbd & ROW1)==0) 
021E:  MOVF   06,W
021F:  ANDLW  04
0220:  BTFSS  03.2
0221:  GOTO   225
....................                row=1; 
0222:  MOVLW  01
0223:  MOVWF  3C
0224:  GOTO   232
....................              else if((kbd & ROW2)==0) 
0225:  MOVF   06,W
0226:  ANDLW  08
0227:  BTFSS  03.2
0228:  GOTO   22C
....................                row=2; 
0229:  MOVLW  02
022A:  MOVWF  3C
022B:  GOTO   232
....................              else if((kbd & ROW3)==0) 
022C:  MOVF   06,W
022D:  ANDLW  10
022E:  BTFSS  03.2
022F:  GOTO   232
....................                row=3; 
0230:  MOVLW  03
0231:  MOVWF  3C
....................              last_key =KEYS[row][col]; 
0232:  MOVF   3C,W
0233:  MOVWF  3D
0234:  MOVLW  03
0235:  MOVWF  3E
0236:  CALL   1C1
0237:  MOVF   2F,W
0238:  ADDWF  78,W
0239:  CALL   051
023A:  MOVWF  78
023B:  MOVWF  2E
....................              kbd_down = TRUE; 
023C:  BSF    2D.0
....................           } else { 
023D:  GOTO   243
....................              ++col; 
023E:  INCF   2F,F
....................              if(col==3) 
023F:  MOVF   2F,W
0240:  SUBLW  03
0241:  BTFSC  03.2
....................                col=0; 
0242:  CLRF   2F
....................           } 
....................        } 
....................       kbd_call_count=0; 
0243:  CLRF   2C
....................    } 
....................   set_tris_kbd(ALL_PINS); 
0244:  MOVLW  FE
0245:  BSF    03.5
0246:  MOVWF  06
....................   return(kchar); 
0247:  BCF    03.5
0248:  MOVF   3B,W
0249:  MOVWF  78
024A:  RETURN
.................... } 
