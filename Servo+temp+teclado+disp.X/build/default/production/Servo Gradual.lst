0254:  XORLW  01
0255:  BTFSC  03.2
0256:  GOTO   261
0257:  XORLW  03
0258:  BTFSC  03.2
0259:  GOTO   267
025A:  GOTO   26C
....................          case 0   : set_tris_kbd(ALL_PINS&~COL0); 
025B:  MOVLW  DE
025C:  BSF    03.5
025D:  MOVWF  06
....................                     kbd=~COL0&ALL_PINS; 
025E:  BCF    03.5
025F:  MOVWF  06
....................                     break; 
0260:  GOTO   26C
....................          case 1   : set_tris_kbd(ALL_PINS&~COL1); 
0261:  MOVLW  BE
0262:  BSF    03.5
0263:  MOVWF  06
....................                     kbd=~COL1&ALL_PINS; 
0264:  BCF    03.5
0265:  MOVWF  06
....................                     break; 
0266:  GOTO   26C
....................          case 2   : set_tris_kbd(ALL_PINS&~COL2); 
0267:  MOVLW  7E
0268:  BSF    03.5
0269:  MOVWF  06
....................                     kbd=~COL2&ALL_PINS; 
026A:  BCF    03.5
026B:  MOVWF  06
....................                     break; 
....................        } 
....................  
....................        if(kbd_down) { 
026C:  BTFSS  31.0
026D:  GOTO   278
....................          if((kbd & (ALL_ROWS))==(ALL_ROWS)) { 
026E:  MOVF   06,W
026F:  ANDLW  1E
0270:  SUBLW  1E
0271:  BTFSS  03.2
0272:  GOTO   277
....................            kbd_down=FALSE; 
0273:  BCF    31.0
....................            kchar=last_key; 
0274:  MOVF   32,W
0275:  MOVWF  46
....................            last_key='\0'; 
0276:  CLRF   32
....................          } 
....................        } else { 
0277:  GOTO   2A8
....................           if((kbd & (ALL_ROWS))!=(ALL_ROWS)) { 
0278:  MOVF   06,W
0279:  ANDLW  1E
027A:  SUBLW  1E
027B:  BTFSC  03.2
027C:  GOTO   2A3
....................              if((kbd & ROW0)==0) 
027D:  MOVF   06,W
027E:  ANDLW  02
027F:  BTFSS  03.2
0280:  GOTO   283
....................                row=0; 
0281:  CLRF   47
0282:  GOTO   297
....................              else if((kbd & ROW1)==0) 
0283:  MOVF   06,W
0284:  ANDLW  04
0285:  BTFSS  03.2
0286:  GOTO   28A
....................                row=1; 
0287:  MOVLW  01
0288:  MOVWF  47
0289:  GOTO   297
....................              else if((kbd & ROW2)==0) 
028A:  MOVF   06,W
028B:  ANDLW  08
028C:  BTFSS  03.2
028D:  GOTO   291
....................                row=2; 
028E:  MOVLW  02
028F:  MOVWF  47
0290:  GOTO   297
....................              else if((kbd & ROW3)==0) 
0291:  MOVF   06,W
0292:  ANDLW  10
0293:  BTFSS  03.2
0294:  GOTO   297
....................                row=3; 
0295:  MOVLW  03
0296:  MOVWF  47
....................              last_key =KEYS[row][col]; 
0297:  MOVF   47,W
0298:  MOVWF  48
0299:  MOVLW  03
029A:  MOVWF  49
029B:  CALL   226
029C:  MOVF   33,W
029D:  ADDWF  21,W
029E:  CALL   059
029F:  MOVWF  21
02A0:  MOVWF  32
....................              kbd_down = TRUE; 
02A1:  BSF    31.0
....................           } else { 
02A2:  GOTO   2A8
....................              ++col; 
02A3:  INCF   33,F
....................              if(col==3) 
02A4:  MOVF   33,W
02A5:  SUBLW  03
02A6:  BTFSC  03.2
....................                col=0; 
02A7:  CLRF   33
....................           } 
....................        } 
....................       kbd_call_count=0; 
02A8:  CLRF   30
....................    } 
....................   set_tris_kbd(ALL_PINS); 
02A9:  MOVLW  FE
02AA:  BSF    03.5
02AB:  MOVWF  06
....................   return(kchar); 
02AC:  BCF    03.5
02AD:  MOVF   46,W
02AE:  MOVWF  21
02AF:  RETURN
.................... } 
