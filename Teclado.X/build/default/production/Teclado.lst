....................   set_tris_kbd(ALL_PINS); 
01DD:  MOVLW  FE
01DE:  BSF    03.5
01DF:  MOVWF  07
01E0:  BCF    03.5
01E1:  MOVWF  24
....................   return(kchar); 
01E2:  MOVF   26,W
01E3:  MOVWF  78
01E4:  BCF    0A.3
01E5:  BCF    0A.4
01E6:  GOTO   20B (RETURN)
