01A3:  ANDLW  10
01A4:  BTFSS  03.2
01A5:  GOTO   1A8
....................                row=3; 
01A6:  MOVLW  03
01A7:  MOVWF  27
....................              last_key =KEYS[row][col]; 
01A8:  MOVF   27,W
01A9:  MOVWF  28
01AA:  MOVLW  03
01AB:  MOVWF  29
*
01D0:  MOVF   23,W
01D1:  ADDWF  78,W
