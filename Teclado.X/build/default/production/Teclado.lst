....................           if((kbd & (ALL_ROWS))!=(ALL_ROWS)) { 
0189:  MOVF   07,W
018A:  ANDLW  1E
018B:  SUBLW  1E
018C:  BTFSC  03.2
018D:  GOTO   1D7
....................              if((kbd & ROW0)==0) 
018E:  MOVF   07,W
018F:  ANDLW  02
0190:  BTFSS  03.2
0191:  GOTO   194
....................                row=0; 
0192:  CLRF   27
0193:  GOTO   1A8
....................              else if((kbd & ROW1)==0) 
0194:  MOVF   07,W
0195:  ANDLW  04
0196:  BTFSS  03.2
0197:  GOTO   19B
....................                row=1; 
0198:  MOVLW  01
0199:  MOVWF  27
019A:  GOTO   1A8
....................              else if((kbd & ROW2)==0) 
019B:  MOVF   07,W
019C:  ANDLW  08
019D:  BTFSS  03.2
019E:  GOTO   1A2
....................                row=2; 
019F:  MOVLW  02
01A0:  MOVWF  27
01A1:  GOTO   1A8
....................              else if((kbd & ROW3)==0) 
