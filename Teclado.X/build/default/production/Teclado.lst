015C:  SUBLW  21
015D:  BTFSC  03.0
015E:  GOTO   1DD
....................        switch (col) { 
015F:  MOVF   23,W
0160:  BTFSC  03.2
0161:  GOTO   169
0162:  XORLW  01
0163:  BTFSC  03.2
0164:  GOTO   170
0165:  XORLW  03
0166:  BTFSC  03.2
0167:  GOTO   177
0168:  GOTO   17D
....................          case 0   : set_tris_kbd(ALL_PINS&~COL0); 
0169:  MOVLW  DE
016A:  BSF    03.5
016B:  MOVWF  07
016C:  BCF    03.5
016D:  MOVWF  24
....................                     kbd=~COL0&ALL_PINS; 
016E:  MOVWF  07
....................                     break; 
016F:  GOTO   17D
....................          case 1   : set_tris_kbd(ALL_PINS&~COL1); 
0170:  MOVLW  BE
0171:  BSF    03.5
0172:  MOVWF  07
0173:  BCF    03.5
0174:  MOVWF  24
....................                     kbd=~COL1&ALL_PINS; 
0175:  MOVWF  07
....................                     break; 
0176:  GOTO   17D
....................          case 2   : set_tris_kbd(ALL_PINS&~COL2); 
0177:  MOVLW  7E
0178:  BSF    03.5
0179:  MOVWF  07
017A:  BCF    03.5
017B:  MOVWF  24
....................                     kbd=~COL2&ALL_PINS; 
017C:  MOVWF  07
....................                     break; 
....................        } 
....................  
....................        if(kbd_down) { 
017D:  BTFSS  21.0
017E:  GOTO   189
....................          if((kbd & (ALL_ROWS))==(ALL_ROWS)) { 
017F:  MOVF   07,W
0180:  ANDLW  1E
0181:  SUBLW  1E
0182:  BTFSS  03.2
0183:  GOTO   188
....................            kbd_down=FALSE; 
0184:  BCF    21.0
....................            kchar=last_key; 
0185:  MOVF   22,W
0186:  MOVWF  26
....................            last_key='\0'; 
0187:  CLRF   22
....................          } 
....................        } else { 
