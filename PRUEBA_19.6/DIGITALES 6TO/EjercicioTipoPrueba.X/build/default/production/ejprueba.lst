.................... void cambiar_temp(void) 
.................... { 
....................     disable_interrupts(INT_TIMER0); 
....................     write_eeprom(0x00,1); 
....................     lcd_putc("\fIngrese\n"); 
....................     printf(lcd_putc,"Temper.Min (   )"); 
....................     k = kbd_getc(); 
....................     while(K != '1' & k != '0') { 
....................         k = kbd_getc(); 
....................     } 
....................     lcd_gotoxy(13,2); 
....................     printf(lcd_putc,"%c", k); 
....................     temp = (k - 48) * 100; 
....................     delay_ms(400); 
....................     k = kbd_getc(); 
....................  
....................     if(temp < 100) { 
....................         while(k == 0 | k == '*' | k == '#') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     if(temp == 100) { 
....................         while(k > 53 | k == 0 | k == '*' | k == '#') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     lcd_gotoxy(14,2); 
....................     printf(lcd_putc,"%c", k); 
....................     temp += (k - 48) * 10; 
....................     delay_ms(400); 
....................     k = kbd_getc(); 
....................  
....................     if(temp == 150) { 
....................         while(k != '0') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     if(temp < 150) { 
....................         while(k == 0 | k == '*' | k == '#') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     lcd_gotoxy(15,2); 
....................     printf(lcd_putc,"%c", k); 
....................     temp += (k - 48); 
....................     tmin = temp; 
....................     delay_ms(800); 
....................  
....................     lcd_putc("\fIngrese\n"); 
....................     printf(lcd_putc,"Temper.Max (   )"); 
....................     k = kbd_getc(); 
....................     while(K != '1' & k != '0') { 
....................         k = kbd_getc(); 
....................     } 
....................     lcd_gotoxy(13,2); 
....................     printf(lcd_putc,"%c", k); 
....................     temp = (k - 48) * 100; 
....................     delay_ms(400); 
....................     k = kbd_getc(); 
....................  
....................     if(temp < 100) { 
....................         while(k == 0 | k == '*' | k == '#') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     if(temp == 100) { 
....................         while(k > 53 | k == 0 | k == '*' | k == '#') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     lcd_gotoxy(14,2); 
....................     printf(lcd_putc,"%c", k); 
....................     temp += (k - 48) * 10; 
....................     delay_ms(400); 
....................     k = kbd_getc(); 
....................  
....................     if(temp == 150) { 
....................         while(k != '0') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     if(temp < 150) { 
....................         while(k == 0 | k == '*' | k == '#') { 
....................             k = kbd_getc(); 
....................         } 
....................     } 
....................     lcd_gotoxy(15,2); 
....................     printf(lcd_putc,"%c", k); 
....................     temp += (k - 48); 
....................     tmax = temp; 
....................     delay_ms(800); 
.................... } 

