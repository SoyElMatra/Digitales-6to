....................  
.................... void inicbuff(void){                   // Inicia a  cbuff ------------------- 
....................    int i; 
....................  
....................    for(i=0;i<lenbuff;i++){             // Bucle que pone a 0 todos los 
*
0090:  CLRF   58
0091:  MOVF   58,W
0092:  SUBLW  1F
0093:  BTFSS  03.0
0094:  GOTO   09B
