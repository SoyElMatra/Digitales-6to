....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
....................    n |= input(LCD_DATA5) << 1; 
....................    n |= input(LCD_DATA6) << 2; 
....................    n |= input(LCD_DATA7) << 3; 
....................     
....................    return(n); 
....................   #else 
....................    return(lcd.data); 
*
00A7:  MOVF   06,W
00A8:  MOVWF  77
00A9:  SWAPF  06,W
00AA:  ANDLW  0F
00AB:  MOVWF  78
....................   #endif 
00AC:  RETURN
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
....................   #else       
....................    lcdlat.data = n; 
*
009B:  SWAPF  4D,W
009C:  ANDLW  F0
009D:  MOVWF  77
009E:  MOVLW  0F
009F:  ANDWF  06,W
00A0:  IORWF  77,W
00A1:  MOVWF  06
....................   #endif 
....................        
....................    delay_cycles(1); 
00A2:  NOP
....................    lcd_output_enable(1); 
00A3:  BSF    06.0
....................    delay_us(2); 
00A4:  GOTO   0A5
....................    lcd_output_enable(0); 
00A5:  BCF    06.0
00A6:  RETURN
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
00AD:  BSF    03.5
00AE:  BCF    06.0
....................    lcd_rs_tris(); 
00AF:  BCF    06.1
....................    lcd_rw_tris(); 
00B0:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
00B1:  BCF    03.5
00B2:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
00D4:  MOVF   78,W
00D5:  MOVWF  4C
00D6:  BTFSC  4C.7
00D7:  GOTO   0B3
....................    lcd_output_rs(address); 
00D8:  BTFSS  4A.0
00D9:  BCF    06.1
00DA:  BTFSC  4A.0
00DB:  BSF    06.1
....................    delay_cycles(1); 
00DC:  NOP
....................    lcd_output_rw(0); 
00DD:  BCF    06.2
....................    delay_cycles(1); 
00DE:  NOP
....................    lcd_output_enable(0); 
00DF:  BCF    06.0
....................    lcd_send_nibble(n >> 4); 
00E0:  SWAPF  4B,W
00E1:  MOVWF  4C
00E2:  MOVLW  0F
00E3:  ANDWF  4C,F
00E4:  MOVF   4C,W
00E5:  MOVWF  4D
00E6:  CALL   09B
....................    lcd_send_nibble(n & 0xf); 
00E7:  MOVF   4B,W
00E8:  ANDLW  0F
00E9:  MOVWF  4C
00EA:  MOVWF  4D
00EB:  CALL   09B
00EC:  RETURN
.................... } 
